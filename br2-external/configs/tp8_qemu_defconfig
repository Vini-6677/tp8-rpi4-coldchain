BR2_aarch64=y
BR2_cortex_a72=y

# Toolchain Externa Pre-compilada Bootlin (acelera o build em ~30 minutos)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y


# Build determinístico e reprodutível
BR2_REPRODUCIBLE=y

# Hostname e Rede
BR2_TARGET_GENERIC_HOSTNAME="coldchain-rpi4"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_TP8_COLDCHAIN_PATH)/users_table.txt"
BR2_SYSTEM_DHCP="eth0"

# Sistema de inicialização rápido e determinístico
BR2_INIT_BUSYBOX=y

# Overlays e Tabelas de Usuários (será configurado no commit 03 e 04)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TP8_COLDCHAIN_PATH)/board/common/overlay"

# Kernel Linux para QEMU virt AArch64 com fragmento Docker
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TP8_COLDCHAIN_PATH)/board/common/kernel-docker.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Runtime Docker e Dependências Obrigatórias (Requisito 5)
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_CONTAINERD=y
BR2_PACKAGE_RUNC=y
BR2_PACKAGE_TINI=y
BR2_PACKAGE_IPTABLES=y

# Ferramentas de Sistema, Rede e Persistência
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Partição RootFS ext4 (somente leitura)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"
# BR2_TARGET_ROOTFS_TAR is not set

# Ferramentas Host
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y

BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_TP8_COLDCHAIN_PATH)/device_table.txt"
