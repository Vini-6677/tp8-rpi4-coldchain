#!/bin/sh
# S99coldchain - Inicializacao segura dos containers Mosquitto e Coldchain

case "$1" in
  start)
    # Se o sistema estiver em modo seguro apos falha grave de fsck, nao inicia containers
    if [ -f /run/safe-mode ]; then
      echo "[!] MODO SEGURO ATIVO: Containers suspensos para recuperacao."
      exit 0
    fi

    DOCKER_SUBNET=${DOCKER_SUBNET:-"172.30.0.0/24"}

    # Aguarda o socket do Docker daemon responder antes de prosseguir (max 30s)
    echo "[*] Aguardando Docker daemon..."
    WAIT=0
    while ! docker info >/dev/null 2>&1 && [ $WAIT -lt 30 ]; do
      sleep 1
      WAIT=$((WAIT + 1))
    done

    # Cria diretorios de dados persistentes com permissoes corretas
    mkdir -p /data/mosquitto /data/coldchain
    chown -R 1883:1883 /data/mosquitto
    chown -R 10001:10001 /data/coldchain

    # Nivel 1: Primeiro boot (Provisionamento inicial das imagens offline)
    if [ ! -f /data/.provisioned ]; then
      echo "[+] Primeiro boot: Carregando imagens Docker offline de /opt/docker/..."
      
      # Carrega as imagens tarball pre-armazenadas
      for img in /opt/docker/*.tar.gz /opt/docker/*.tar; do
        if [ -f "$img" ]; then
          echo "    - Carregando $img..."
          docker load -i "$img"
        fi
      done

      # Cria a rede bridge isolada br-coldchain
      docker network inspect coldchain-net >/dev/null 2>&1 || \
      docker network create --driver bridge --subnet "$DOCKER_SUBNET" \
        -o com.docker.network.bridge.name=br-coldchain coldchain-net

      # Cria container do broker Mosquitto (Eclipse 2.x) com uid 1883
      echo "[+] Criando container Mosquitto..."
      docker create --name mosquitto --restart always --network coldchain-net \
        --user 1883:1883 \
        --read-only --tmpfs /tmp:size=4m --cap-drop ALL \
        --security-opt no-new-privileges --pids-limit 64 --memory 64m \
        --oom-score-adj -500 \
        -v /etc/coldchain/mosquitto:/mosquitto/config:ro \
        -v /data/mosquitto:/mosquitto/data \
        -p 1883:1883 \
        --health-cmd "nc -z 127.0.0.1 1883" \
        --health-interval 15s --health-timeout 2s --health-retries 3 \
        --health-start-period 5s \
        eclipse-mosquitto:2.0

      # Cria container da aplicacao Go em scratch com uid 10001
      echo "[+] Criando container Coldchain..."
      docker create --name coldchain --restart always --network coldchain-net \
        --user 10001:10001 \
        --read-only --tmpfs /tmp:size=16m,mode=1777 --cap-drop ALL \
        --security-opt no-new-privileges \
        --pids-limit 128 --memory 128m --stop-timeout 20 \
        -e MQTT_URL=tcp://mosquitto:1883 -e GOMEMLIMIT=96MiB \
        -v /etc/coldchain/app-secrets:/run/secrets:ro \
        -v /data/coldchain:/data \
        -p 5000:5000 \
        coldchain-tp8:1.0.0

      # Inicia ambos
      echo "[+] Iniciando containers..."
      docker start mosquitto coldchain
      touch /data/.provisioned
    else
      # Nivel 2: Containers ja provisionados, garante que estao rodando
      echo "[+] Iniciando containers existentes..."
      docker start mosquitto coldchain
    fi

    # Animacao de abertura no console antes do prompt de login
    printf "\033[2J\033[H"
    printf "\033[1;36m==========================================================================\033[0m\n"
    printf "\033[1;37m   INICIALIZANDO GATEWAY SANITARIO COLDCHAIN PHARMA RT (ARM64)\033[0m\n"
    printf "\033[1;36m==========================================================================\033[0m\n\n"
    printf "  \033[1;34m[####................]  20%%\033[0m  Montando Particao Criptografica WORM (/data)...\r"
    usleep 250000 2>/dev/null || sleep 1
    printf "  \033[1;34m[#########...........]  45%%\033[0m  Ativando Isolamento Docker & Cgroups v2...      \r"
    usleep 250000 2>/dev/null || true
    printf "  \033[1;36m[##############......]  70%%\033[0m  Sincronizando Broker MQTT TLS/ACL (:1883)...     \r"
    usleep 250000 2>/dev/null || true
    printf "  \033[1;36m[##################..]  90%%\033[0m  Verificando Ledger ECDSA P-256 (:5000)...        \r"
    usleep 250000 2>/dev/null || true
    printf "  \033[1;32m[####################] 100%%  SISTEMA VALIDADO — ANVISA RDC 430 & 21 CFR 11   \033[0m\n\n"
    usleep 200000 2>/dev/null || true
    printf "  \033[1;33m>>> Helooowww world eng. Computacional!!!!!!! <<<\033[0m\n\n"
    usleep 400000 2>/dev/null || true
    ;;
  stop)
    echo "[*] Parando containers..."
    docker stop coldchain mosquitto
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
