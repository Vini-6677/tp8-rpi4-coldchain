#!/bin/sh
# S99coldchain - Inicialização segura dos containers Mosquitto e Coldchain

case "$1" in
  start)
    # Se o sistema estiver em modo seguro após falha grave de fsck, não inicia containers
    if [ -f /run/safe-mode ]; then
      echo "[!] MODO SEGURO ATIVO: Containers suspensos para recuperação."
      exit 0
    fi

    DOCKER_SUBNET=${DOCKER_SUBNET:-"172.30.0.0/24"}

    # Nível 1: Primeiro boot (Provisionamento inicial das imagens offline)
    if [ ! -f /data/.provisioned ]; then
      echo "[+] Primeiro boot: Carregando imagens Docker offline de /opt/docker/..."
      
      # Carrega as imagens tarball pré-armazenadas
      for img in /opt/docker/*.tar.gz /opt/docker/*.tar; do
        if [ -f "$img" ]; then
          docker load -i "$img" >/dev/null 2>&1
        fi
      done

      # Cria a rede bridge isolada br-coldchain
      docker network inspect coldchain-net >/dev/null 2>&1 || \
      docker network create --driver bridge --subnet "$DOCKER_SUBNET" \
        -o com.docker.network.bridge.name=br-coldchain coldchain-net

      # Cria container do broker Mosquitto (Eclipse 2.x) com uid 1883
      docker create --name mosquitto --restart always --network coldchain-net \
        --user 1883:1883 \
        --read-only --tmpfs /tmp:size=4m --cap-drop ALL \
        --security-opt no-new-privileges --pids-limit 64 --memory 64m \
        --oom-score-adj -500 \
        -v /etc/coldchain/mosquitto:/mosquitto/config:ro \
        -v /data/mosquitto:/mosquitto/data \
        -p 1883:1883 \
        --health-cmd "nc -z 127.0.0.1 1883" \
        --health-interval 15s --health-timeout 2s --health-retries 3 \
        --health-start-period 5s \
        eclipse-mosquitto:2.0 >/dev/null 2>&1

      # Cria container da aplicação Go em scratch com uid 10001
      docker create --name coldchain --restart always --network coldchain-net \
        --user 10001:10001 \
        --read-only --tmpfs /tmp:size=16m,mode=1777 --cap-drop ALL \
        --security-opt no-new-privileges \
        --pids-limit 128 --memory 128m --stop-timeout 20 \
        -e MQTT_URL=tcp://mosquitto:1883 -e GOMEMLIMIT=96MiB \
        -v /etc/coldchain/app-secrets:/run/secrets:ro \
        -v /data/coldchain:/data \
        -p 5000:5000 \
        --health-cmd "/app/coldchain -healthcheck" \
        --health-interval 15s --health-timeout 2s --health-retries 3 \
        --health-start-period 5s \
        coldchain-tp8:1.0.0 >/dev/null 2>&1

      # Inicia ambos
      docker start mosquitto coldchain >/dev/null 2>&1
      touch /data/.provisioned
    else
      # Nível 2: Containers já provisionados, garante que estão rodando
      docker start mosquitto coldchain >/dev/null 2>&1
    fi
    ;;
  stop)
    docker stop coldchain mosquitto >/dev/null 2>&1
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
